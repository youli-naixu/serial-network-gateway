  "keywords": "rfc2217, serial, uart, wifi, bootloader",
  "license": "Apache-2.0",
  "frameworks": "arduino",
  "platforms": "espressif32",
  "dependencies": [
    { "name": "WiFi" }
  ],
  "build": {
